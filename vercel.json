{
  "buildCommand": "pnpm build",
  "outputDirectory": "build",
  "installCommand": "pnpm install",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.1claw.xyz"
        }
      ],
      "destination": "https://docs.1claw.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "docs.1claw.xyz"
        }
      ],
      "destination": "https://docs.1claw.co/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "1claw-docs.vercel.app"
        }
      ],
      "destination": "https://docs.1claw.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "1claw-docs.vercel.app"
        }
      ],
      "destination": "https://docs.1claw.co/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "1claw-docs-kevinkevinjonescrs-projects.vercel.app"
        }
      ],
      "destination": "https://docs.1claw.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "1claw-docs-kevinkevinjonescrs-projects.vercel.app"
        }
      ],
      "destination": "https://docs.1claw.co/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "1claw-docs-git-main-kevinkevinjonescrs-projects.vercel.app"
        }
      ],
      "destination": "https://docs.1claw.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "1claw-docs-git-main-kevinkevinjonescrs-projects.vercel.app"
        }
      ],
      "destination": "https://docs.1claw.co/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.docs.1claw.co"
        }
      ],
      "destination": "https://docs.1claw.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.docs.1claw.co"
        }
      ],
      "destination": "https://docs.1claw.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/llms-full.txt"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
